datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  STUDENT
  MENTOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  BLOCKED
  PENDING
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id          String       @id @default(uuid())
  fullName    String
  email       String       @unique
  password    String
  role        UserRole     @default(STUDENT)
  status      UserStatus   @default(ACTIVE)
  isVerified  Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Relational mappings
  submissions Submission[] @relation("StudentSubmissions")
  reviews     Review[]     @relation("MentorReviews")

  @@map("users")
}

model Submission {
  id          String           @id @default(uuid())
  projectName String
  repoUrl     String
  liveLink    String
  description String           @db.Text
  status      SubmissionStatus @default(PENDING)

  // Student relation
  studentId   String
  student     User             @relation("StudentSubmissions", fields: [studentId], references: [id], onDelete: Cascade)

  // Review history relation
  reviews     Review[]

  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  // Composite indexes for fast server-side filtering, searching & duplicate checking
  @@index([status])
  @@index([studentId])
  @@index([createdAt])
  @@index([studentId, repoUrl, status])
  @@map("submissions")
}

model Review {
  id           String           @id @default(uuid())
  submissionId String
  submission   Submission       @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  reviewerId   String
  reviewer     User             @relation("MentorReviews", fields: [reviewerId], references: [id], onDelete: Restrict)

  status       SubmissionStatus // APPROVED or REJECTED
  feedback     String?          @db.Text

  createdAt    DateTime         @default(now())

  @@index([submissionId])
  @@index([reviewerId])
  @@map("reviews")
}
